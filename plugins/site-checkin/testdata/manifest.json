{
  "contractVersion": 2,
  "id": "site-checkin",
  "name": "站点自动签到",
  "version": "1.0.0",
  "author": "Media Tool Contributors",
  "description": "宿主附认证的有界签到；失败或验证码需人工处理，不绕过验证。",
  "level": 2,
  "icon": "icon.svg",
  "history": {
    "1.0.0": "F6-α：有界、默认不执行业务、Host 实时授权与幂等收据"
  },
  "permissions": [
    {
      "scope": "plugin.config.read"
    },
    {
      "scope": "plugin.data.read"
    },
    {
      "scope": "plugin.data.write"
    },
    {
      "scope": "ui.json"
    },
    {
      "scope": "services.register"
    },
    {
      "scope": "sites.request"
    },
    {
      "scope": "notifications.send"
    }
  ],
  "extensions": {
    "forms": true,
    "pages": [
      "status"
    ],
    "services": [
      "checkin"
    ]
  },
  "ui": {
    "mode": "json"
  },
  "resources": {
    "addressSpaceMiB": 8192,
    "rssMiB": 256,
    "cpuQuotaPercent": 100,
    "processes": 64,
    "openFiles": 256,
    "dataMiB": 256,
    "tmpMiB": 64
  },
  "configSchemaVersion": 1,
  "dataSchemaVersion": 1
}
