{
  "contractVersion": 2,
  "id": "hello-go",
  "name": "Hello Go",
  "version": "1.4.0",
  "author": "Example Author",
  "description": "实例隔离与持久计数示例",
  "level": 1,
  "icon": "icon.svg",
  "history": {
    "1.0.0": "Initial example",
    "1.1.0": "Typed bindings, authenticated APIs, durable service and transfer event example",
    "1.1.1": "Demonstrate POST admin API for CSRF contract",
    "1.1.2": "Declare minimal per-route Host execution scopes",
    "1.2.0": "Chain/module hooks, DownloadAdded, JSON forms, multi dashboards and bundled ESM",
    "1.3.0": "Manual F3 read-only host acceptance and denied-scope check",
    "1.4.0": "Typed acquisition facts and no-op resource policy chains (F4-A)"
  },
  "permissions": [
    {
      "scope": "plugin.config.read"
    },
    {
      "scope": "plugin.data.read"
    },
    {
      "scope": "plugin.data.write"
    },
    {
      "scope": "plugin.state.read"
    },
    {
      "scope": "ui.json"
    },
    {
      "scope": "api.register"
    },
    {
      "scope": "api.public"
    },
    {
      "scope": "services.register"
    },
    {
      "scope": "commands.register"
    },
    {
      "scope": "actions.register"
    },
    {
      "scope": "events.subscribe.library.organized"
    },
    {
      "scope": "plugin.config.write"
    },
    {
      "scope": "events.chain.name.recognize"
    },
    {
      "scope": "module.metadata.name_recognize"
    },
    {
      "scope": "events.subscribe.download.added"
    },
    {
      "scope": "ui.trusted"
    },
    {
      "scope": "ui.sidebar"
    },
    {
      "scope": "downloads.read"
    },
    {
      "scope": "library.read"
    },
    {
      "scope": "mediaserver.read"
    },
    {
      "scope": "cache.read"
    },
    {
      "scope": "integrations.read"
    },
    {
      "scope": "jobs.read"
    },
    {
      "scope": "maintenance.read"
    },
    {
      "scope": "notifications.read"
    },
    {
      "scope": "settings.read"
    },
    {
      "scope": "system.read"
    },
    {
      "scope": "events.subscribe.site.account.updated"
    },
    {
      "scope": "events.subscribe.site.account.deleted"
    },
    {
      "scope": "events.subscribe.site.metrics.refreshed"
    },
    {
      "scope": "events.subscribe.subscription.created"
    },
    {
      "scope": "events.subscribe.subscription.updated"
    },
    {
      "scope": "events.subscribe.subscription.deleted"
    },
    {
      "scope": "events.chain.resource.selection"
    },
    {
      "scope": "events.chain.resource.download"
    }
  ],
  "extensions": {
    "forms": true,
    "pages": [
      "overview"
    ],
    "api": [
      {
        "id": "admin",
        "path": "/admin",
        "methods": [
          "GET",
          "POST"
        ],
        "auth": "admin",
        "executionScopes": [
          "plugin.data.read",
          "plugin.data.write"
        ],
        "summary": "Hello counter"
      },
      {
        "id": "apikey",
        "path": "/apikey",
        "methods": [
          "GET"
        ],
        "auth": "apikey",
        "executionScopes": [
          "plugin.data.read"
        ],
        "summary": "Hello counter"
      },
      {
        "id": "bearer",
        "path": "/bearer",
        "methods": [
          "GET"
        ],
        "auth": "bearer",
        "executionScopes": [
          "plugin.data.read"
        ],
        "summary": "Hello counter"
      },
      {
        "id": "public",
        "path": "/public",
        "methods": [
          "GET"
        ],
        "auth": "public",
        "executionScopes": [
          "plugin.data.read"
        ],
        "summary": "Hello counter"
      }
    ],
    "services": [
      "tick"
    ],
    "commands": [
      "hello"
    ],
    "actions": [
      "hello",
      "f3-read-check"
    ],
    "events": [
      "library.organized",
      "download.added",
      "site.account.updated",
      "site.account.deleted",
      "site.metrics.refreshed",
      "subscription.created",
      "subscription.updated",
      "subscription.deleted"
    ],
    "chains": [
      "name.recognize",
      "resource.selection",
      "resource.download"
    ],
    "modules": [
      "metadata.name_recognize"
    ],
    "dashboards": [
      "starts",
      "events"
    ]
  },
  "ui": {
    "mode": "vue",
    "entry": "ui/dist/index.js",
    "sidebar": [
      {
        "page": "overview",
        "title": "Hello 插件",
        "icon": "Box"
      }
    ]
  },
  "resources": {
    "addressSpaceMiB": 8192,
    "rssMiB": 256,
    "cpuQuotaPercent": 100,
    "processes": 64,
    "openFiles": 256,
    "dataMiB": 256,
    "tmpMiB": 64
  },
  "configSchemaVersion": 1,
  "dataSchemaVersion": 1
}
