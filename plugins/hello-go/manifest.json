{
  "contractVersion": 2,
  "id": "hello-go",
  "name": "Hello Go",
  "version": "1.1.1",
  "author": "Example Author",
  "description": "实例隔离与持久计数示例",
  "level": 1,
  "icon": "icon.svg",
  "history": {
    "1.0.0": "Initial example",
    "1.1.0": "Typed bindings, authenticated APIs, durable service and transfer event example",
    "1.1.1": "Demonstrate POST admin API for CSRF contract"
  },
  "permissions": [
    {
      "scope": "plugin.config.read"
    },
    {
      "scope": "plugin.data.read"
    },
    {
      "scope": "plugin.data.write"
    },
    {
      "scope": "plugin.state.read"
    },
    {
      "scope": "ui.json"
    },
    {
      "scope": "api.register"
    },
    {
      "scope": "api.public"
    },
    {
      "scope": "services.register"
    },
    {
      "scope": "commands.register"
    },
    {
      "scope": "actions.register"
    },
    {
      "scope": "events.subscribe.library.organized"
    }
  ],
  "extensions": {
    "forms": true,
    "pages": [
      "overview"
    ],
    "api": [
      {
        "id": "admin",
        "path": "/admin",
        "methods": [
          "GET",
          "POST"
        ],
        "auth": "admin",
        "executionScopes": [],
        "summary": "Hello counter"
      },
      {
        "id": "apikey",
        "path": "/apikey",
        "methods": [
          "GET"
        ],
        "auth": "apikey",
        "executionScopes": [],
        "summary": "Hello counter"
      },
      {
        "id": "bearer",
        "path": "/bearer",
        "methods": [
          "GET"
        ],
        "auth": "bearer",
        "executionScopes": [],
        "summary": "Hello counter"
      },
      {
        "id": "public",
        "path": "/public",
        "methods": [
          "GET"
        ],
        "auth": "public",
        "executionScopes": [],
        "summary": "Hello counter"
      }
    ],
    "services": [
      "tick"
    ],
    "commands": [
      "hello"
    ],
    "actions": [
      "hello"
    ],
    "events": [
      "library.organized"
    ]
  },
  "ui": {
    "mode": "json"
  },
  "resources": {
    "addressSpaceMiB": 8192,
    "rssMiB": 256,
    "cpuQuotaPercent": 100,
    "processes": 64,
    "openFiles": 256,
    "dataMiB": 256,
    "tmpMiB": 64
  },
  "configSchemaVersion": 1,
  "dataSchemaVersion": 1
}
