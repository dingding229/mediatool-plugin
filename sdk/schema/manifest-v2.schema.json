{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mediatool:plugin-manifest:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "id",
    "name",
    "version",
    "author",
    "permissions",
    "extensions",
    "ui",
    "resources",
    "configSchemaVersion",
    "dataSchemaVersion",
    "description",
    "level",
    "icon",
    "history"
  ],
  "properties": {
    "contractVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "icon": {
      "$ref": "#/$defs/path"
    },
    "history": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "maxLength": 120
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "libraryIds": {
                "$ref": "#/$defs/ids"
              },
              "storageIds": {
                "$ref": "#/$defs/ids"
              },
              "siteIds": {
                "$ref": "#/$defs/ids"
              },
              "rootIds": {
                "$ref": "#/$defs/ids"
              },
              "hosts": {
                "$ref": "#/$defs/ids"
              },
              "eventTypes": {
                "$ref": "#/$defs/ids"
              },
              "settingKeys": {
                "$ref": "#/$defs/ids"
              },
              "workflowIds": {
                "$ref": "#/$defs/ids"
              }
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forms": {
          "type": "boolean"
        },
        "pages": {
          "$ref": "#/$defs/ids"
        },
        "dashboards": {
          "$ref": "#/$defs/ids"
        },
        "api": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/apiRoute"
          }
        },
        "services": {
          "$ref": "#/$defs/ids"
        },
        "commands": {
          "$ref": "#/$defs/ids"
        },
        "events": {
          "$ref": "#/$defs/ids"
        },
        "chains": {
          "$ref": "#/$defs/ids"
        },
        "modules": {
          "$ref": "#/$defs/ids"
        },
        "actions": {
          "$ref": "#/$defs/ids"
        },
        "authProviders": {
          "$ref": "#/$defs/ids"
        },
        "agentTools": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "json",
            "vue"
          ]
        },
        "entry": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^ui/dist/(?!.*\\.\\.)[A-Za-z0-9_./-]+\\.m?js$"
        },
        "sidebar": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page",
              "title"
            ],
            "properties": {
              "page": {
                "type": "string",
                "maxLength": 64
              },
              "title": {
                "type": "string",
                "maxLength": 120
              },
              "icon": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "addressSpaceMiB": {
          "type": "integer",
          "minimum": 256,
          "maximum": 8192
        },
        "rssMiB": {
          "type": "integer",
          "minimum": 64,
          "maximum": 1024
        },
        "cpuQuotaPercent": {
          "type": "integer",
          "minimum": 10,
          "maximum": 200
        },
        "processes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "openFiles": {
          "type": "integer",
          "minimum": 32,
          "maximum": 1024
        },
        "dataMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "tmpMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "configSchemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "dataSchemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ui": {
            "properties": {
              "mode": {
                "const": "vue"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ui": {
            "required": [
              "entry"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "apiRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "methods",
        "auth",
        "executionScopes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          }
        },
        "auth": {
          "enum": [
            "admin",
            "apikey",
            "bearer",
            "public"
          ]
        },
        "executionScopes": {
          "$ref": "#/$defs/ids"
        },
        "summary": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
    }
  }
}
